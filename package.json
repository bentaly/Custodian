{
  "name": "custodian",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "pnpm build && wrangler dev",
    "deploy": "wrangler deploy",
    "deploy:staging": "wrangler deploy --env staging",
    "typecheck": "tsc --noEmit",
    "lint:a11y": "oxlint",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:tenancy": "vitest run --config vitest.tenancy.config.ts",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx scripts/seed.ts",
    "demo:seed": "tsx scripts/demo/seed.ts",
    "demo:apply": "tsx scripts/demo/apply.ts",
    "demo:decide": "tsx scripts/demo/decide.ts",
    "demo:report": "tsx scripts/demo/report.ts",
    "demo:snapshot": "tsx scripts/demo/snapshot.ts",
    "demo:teardown": "tsx scripts/demo/teardown.ts",
    "demo:all": "pnpm demo:seed && pnpm demo:apply && pnpm demo:decide && pnpm demo:report",
    "geo:build": "tsx scripts/build-geo.ts",
    "prepare": "simple-git-hooks"
  },
  "simple-git-hooks": {
    "pre-push": "pnpm typecheck"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "@hugeicons/core-free-icons": "^4.2.3",
    "@hugeicons/react": "^1.1.9",
    "@neondatabase/serverless": "^1.1.0",
    "@sentry/cloudflare": "^10.69.0",
    "@sentry/react": "^10.69.0",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-router": "^1.170.18",
    "@tanstack/react-start": "^1.168.32",
    "@tiptap/pm": "^3.29.0",
    "@tiptap/react": "^3.29.0",
    "@tiptap/starter-kit": "^3.29.0",
    "better-auth": "^1.6.25",
    "d3-geo": "^3.1.1",
    "drizzle-orm": "^0.45.2",
    "exceljs": "^4.4.0",
    "html2canvas-pro": "^2.3.3",
    "jspdf": "^4.2.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "recharts": "^3.10.1",
    "resend": "^6.18.0",
    "tiptap-markdown": "^0.9.0",
    "topojson-client": "^3.1.0",
    "uk-modulus-checking": "^0.1.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@sentry/vite-plugin": "^5.4.0",
    "@storybook/react-vite": "^10.5.7",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/router-plugin": "^1.168.23",
    "@types/d3-geo": "^3.1.1",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/topojson-client": "^3.1.5",
    "@vitejs/plugin-react": "^6.0.4",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "mapshaper": "^0.7.50",
    "oxfmt": "^0.61.0",
    "oxlint": "^1.76.0",
    "playwright": "1.62.1",
    "postcss": "^8.5.23",
    "prettier": "^3.9.6",
    "simple-git-hooks": "^2.13.1",
    "storybook": "^10.5.7",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vite": "^8.1.5",
    "vitest": "^4.1.10",
    "wrangler": "^4.114.0"
  },
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "packageManager": "pnpm@9.15.0"
}
